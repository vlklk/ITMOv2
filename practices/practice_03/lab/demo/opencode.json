{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k (qwen3.5:9b Q4_K_M)",
          "tool_call": true,
          "reasoning": false,
          "options": {
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "itmo-agent-think": {
          "id": "itmo-agent",
          "name": "ITMO local 64k + thinking (qwen3.5:9b Q4_K_M)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "temperature": 0.2,
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide-strict": {
      "description": "Read-only assistant: tool call before every answer, file:line evidence",
      "mode": "primary",
      "prompt": "{file:./repo-system-strict.txt}",
      "temperature": 0.2,
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
